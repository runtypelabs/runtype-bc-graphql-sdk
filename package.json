{
  "name": "@runtypelabs/runtype-bc-graphql-sdk",
  "version": "1.0.6",
  "description": "BigCommerce Storefront Agent SDK - AI agent integration with BigCommerce storefronts via GraphQL Storefront API",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "browser": "dist/bigcommerce-agent-sdk.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.esm.js",
      "require": "./dist/tools.js"
    },
    "./browser": "./dist/bigcommerce-agent-sdk.min.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && node test/server.mjs",
    "test:e2e": "npm run build && npx playwright test",
    "test:e2e:ui": "npm run build && npx playwright test --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runtypelabs/runtype-bc-graphql-sdk.git"
  },
  "keywords": [
    "bigcommerce",
    "graphql",
    "storefront",
    "sdk",
    "ai",
    "agent",
    "ecommerce",
    "shopping",
    "cart"
  ],
  "author": "Runtype Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/runtypelabs/runtype-bc-graphql-sdk/issues"
  },
  "homepage": "https://github.com/runtypelabs/runtype-bc-graphql-sdk#readme",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
