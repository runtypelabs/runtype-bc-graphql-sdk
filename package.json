{
  "name": "@runtypelabs/runtype-bc-graphql-sdk",
  "version": "1.2.3",
  "description": "BigCommerce Storefront Agent SDK - AI agent integration with BigCommerce storefronts via GraphQL Storefront API",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "browser": "dist/bigcommerce-agent-sdk.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.esm.js",
      "require": "./dist/tools.js"
    },
    "./browser": "./dist/bigcommerce-agent-sdk.min.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && node test/server.mjs",
    "test:e2e": "npm run build && npx playwright test",
    "test:e2e:ui": "npm run build && npx playwright test --ui",
    "generate-certs": "mkdir -p test/certs && openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout test/certs/localhost.key -out test/certs/localhost.crt -subj '/CN=localhost'",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "update-schema": "node scripts/fetch-schema.mjs && npm run codegen",
    "preversion": "npm run lint && npm run typecheck && npm run build && npm test",
    "postversion": "git push && git push --tags",
    "release": "npm version patch",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runtypelabs/runtype-bc-graphql-sdk.git"
  },
  "keywords": [
    "bigcommerce",
    "graphql",
    "storefront",
    "sdk",
    "ai",
    "agent",
    "ecommerce",
    "shopping",
    "cart"
  ],
  "author": "Runtype, Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/runtypelabs/runtype-bc-graphql-sdk/issues"
  },
  "homepage": "https://github.com/runtypelabs/runtype-bc-graphql-sdk#readme",
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "^6.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "graphql": "^17.0.2",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
